# Copy to `.env` for local development. Never commit `.env`.
# In CI these are set as GitHub repo Secrets (Contentful) and Variables (PUBLIC_*).

# --- Contentful (build-time only; the delivery token is read-only) -----------
# Leave BLANK to build with local fixture content (src/lib/fixtures/).
CONTENTFUL_SPACE_ID=
CONTENTFUL_DELIVERY_TOKEN=
CONTENTFUL_ENVIRONMENT=master

# --- Client-side integrations (inlined into the page at build time) ---------
# Formspree form id — the part after /f/ in your form's endpoint URL.
PUBLIC_FORMSPREE_ID=
# Newsletter form POST URL (e.g. a Buttondown embed action URL).
PUBLIC_NEWSLETTER_URL=

# --- Only needed to run contentful/migrate.mjs (never in CI) ---------------
# Contentful *Management* token (personal access token). Not the delivery token.
CONTENTFUL_MANAGEMENT_TOKEN=
