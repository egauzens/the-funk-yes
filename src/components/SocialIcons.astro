---

<ul class:list={["fy-socials", className]} data-align={align}>
  {
    SOCIALS.map((s) => (
      <li>
        <a
          href={s.href}
          rel={s.href.startsWith("http") ? "noopener noreferrer" : undefined}
          target={s.href.startsWith("http") ? "_blank" : undefined}
          aria-label={s.label}
          title={s.label}
        >
          <svg
            width={size}
            height={size}
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={PATHS[s.icon]} />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .fy-socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .fy-socials[data-align="center"] {
    justify-content: center;
  }
  .fy-socials a {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--color-fy-line);
    color: var(--color-fy-ink);
    transition:
      color 0.2s var(--ease-funk),
      border-color 0.2s var(--ease-funk),
      transform 0.2s var(--ease-funk);
  }
  .fy-socials a:hover,
  .fy-socials a:focus-visible {
    color: var(--color-fy-acid);
    border-color: var(--color-fy-acid);
    transform: translateY(-2px);
  }
</style>
