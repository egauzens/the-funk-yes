---
import EmbedFrame from "./EmbedFrame.astro";

interface Props {
  /** Full instagram.com permalink (post or reel). */
  url: string;
  label?: string;
}
const { url, label } = Astro.props;
const isValid = /^https?:\/\/(www\.)?instagram\.com\/(p|reel|tv)\//.test(url);
const permalink = isValid ? url.split("?")[0].replace(/\/?$/, "/") : "";
---

<EmbedFrame label={label} ratio="4 / 5">
  {
    isValid ? (
      <div class="fy-ig">
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={permalink}
          data-instgrm-version="14"
        >
          <a href={permalink}>View this post on Instagram</a>
        </blockquote>
      </div>
    ) : (
      <p class="fy-embed-missing">Set a valid instagram.com post or reel URL.</p>
    )
  }
</EmbedFrame>

<style>
  .fy-ig {
    position: absolute;
    inset: 0;
    overflow: auto;
    background: #000;
  }
  .fy-ig :global(.instagram-media) {
    margin: 0 auto !important;
    min-width: 0 !important;
  }
  .fy-embed-missing {
    padding: 1.5rem;
    color: var(--color-fy-ink-dim);
    font-size: 0.85rem;
  }
</style>

<script>
  // Load Instagram's embed script once, then (re)process blockquotes.
  const SRC = "https://www.instagram.com/embed.js";
  function process() {
    (window as any).instgrm?.Embeds?.process();
  }
  if (document.querySelector(".instagram-media")) {
    if (!document.querySelector(`script[src="${SRC}"]`)) {
      const s = document.createElement("script");
      s.src = SRC;
      s.async = true;
      s.addEventListener("load", process);
      document.body.appendChild(s);
    } else {
      process();
    }
  }
</script>
