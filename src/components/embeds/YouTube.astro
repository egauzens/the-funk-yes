---
import EmbedFrame from "./EmbedFrame.astro";

interface Props {
  /** 11-char video id, or any youtube.com / youtu.be URL. */
  idOrUrl: string;
  title?: string;
  label?: string;
}
const { idOrUrl, title = "Live video", label } = Astro.props;

function extractId(input: string): string | null {
  if (/^[\w-]{11}$/.test(input)) return input;
  const m = input.match(
    /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/))([\w-]{11})/,
  );
  return m ? m[1] : null;
}
const id = extractId(idOrUrl);
const poster = id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : "";
const embed = id
  ? `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1`
  : "";
---

<EmbedFrame label={label} ratio="16 / 9">
  {
    id ? (
      <button
        type="button"
        class="fy-yt"
        data-embed={embed}
        aria-label={`Play video: ${title}`}
      >
        <img src={poster} alt="" loading="lazy" width="480" height="360" />
        <span class="fy-yt__play" aria-hidden="true">
          <svg width="68" height="48" viewBox="0 0 68 48">
            <path
              d="M66.5 7.7a8 8 0 0 0-5.6-5.7C56 1 34 1 34 1s-22 0-26.9 1a8 8 0 0 0-5.6 5.7A83 83 0 0 0 0 24a83 83 0 0 0 1.5 16.3 8 8 0 0 0 5.6 5.7C12 47 34 47 34 47s22 0 26.9-1a8 8 0 0 0 5.6-5.7A83 83 0 0 0 68 24a83 83 0 0 0-1.5-16.3Z"
              fill="#ff2e88"
            />
            <path d="M27 34 45 24 27 14Z" fill="#fff" />
          </svg>
        </span>
      </button>
    ) : (
      <p class="fy-embed-missing">Set a valid YouTube id or URL for “{title}”.</p>
    )
  }
</EmbedFrame>

<style>
  .fy-yt {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: #000;
    cursor: pointer;
  }
  .fy-yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.75;
    transition: opacity 0.2s var(--ease-funk);
  }
  .fy-yt:hover img,
  .fy-yt:focus-visible img {
    opacity: 1;
  }
  .fy-yt__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .fy-embed-missing {
    padding: 1.5rem;
    color: var(--color-fy-ink-dim);
    font-size: 0.85rem;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>(".fy-yt").forEach((btn) => {
    btn.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = btn.dataset.embed!;
      iframe.title = btn.getAttribute("aria-label") ?? "YouTube video";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      btn.replaceWith(iframe);
    });
  });
</script>
