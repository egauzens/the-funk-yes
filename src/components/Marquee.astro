---
interface Props {
  items: string[];
  class?: string;
}
const { items, class: className } = Astro.props;
// The list is duplicated so the -50% translate loops seamlessly.
const doubled = [...items, ...items];
---

<div class:list={["fy-marquee", className]} aria-hidden="true">
  <div class="fy-marquee__track">
    {doubled.map((t) => <span class="fy-marquee__item">{t}</span>)}
  </div>
</div>

<style>
  .fy-marquee__item {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: clamp(1.4rem, 4vw, 2.6rem);
    letter-spacing: 0.04em;
    padding-inline: 1.2rem;
    color: var(--color-fy-ink);
  }
  .fy-marquee__item:nth-child(odd) {
    color: var(--color-fy-acid);
  }
</style>
